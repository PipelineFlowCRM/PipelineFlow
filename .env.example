# Root-level shared environment for `docker compose up`.
# Copy to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=pipelineflow
# For local dev this is fine. For prod, generate a real one and change it.
POSTGRES_PASSWORD=pipelineflow
POSTGRES_DB=pipelineflow
# Bind to 5439 by default to avoid colliding with a native Postgres on 5432.
POSTGRES_PORT=5439

# ── API ───────────────────────────────────────────────────────────────────────
# Internal — Compose wires this for you. Override only if pointing at an external Postgres.
DATABASE_URL=postgresql://pipelineflow:pipelineflow@postgres:5432/pipelineflow

# Public origin of the web app (used for cookies, CORS, presigned-URL redirects).
APP_ORIGIN=http://localhost:5173

# ── S3 (attachments + avatars) ────────────────────────────────────────────────
S3_BUCKET=pipelineflow-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — set to a custom endpoint for MinIO/R2/etc. Leave blank for AWS.
S3_ENDPOINT=

# ── Redis / job queue ─────────────────────────────────────────────────────────
# BullMQ broker. Compose wires REDIS_URL into the api/worker for you; this
# file only needs to expose the host port. Bind to 6380 by default to avoid
# colliding with a native Redis on 6379.
REDIS_PORT=6380
# Optional password. When set, Redis starts with --requirepass and the api/
# worker connect with AUTH. Empty = no password (fine for default
# docker-internal-only setup). Use URL-safe chars only (alphanumeric +
# -_.~), since the password is embedded directly into REDIS_URL without
# URL-encoding.
REDIS_PASSWORD=
# Hard cap on Redis memory. Combined with --maxmemory-policy noeviction
# this means enqueue calls fail loudly when full instead of consuming all
# host RAM.
REDIS_MAXMEMORY=256mb
# Concurrency per worker container.
WORKER_CONCURRENCY=5
# Mounts a queue dashboard at /admin/queues on the api (auth-required). Set
# to false to disable in environments where that surface isn't appropriate.
BULL_BOARD_ENABLED=true
# Smoke-test endpoint (POST /api/jobs/generate). Off by default in the
# compose-shipped prod config. Flip to true when you want to verify the
# producer→broker→consumer path live.
JOBS_TEST_ENDPOINT_ENABLED=false

# ── Networking ────────────────────────────────────────────────────────────────
# Default-deny: published ports listen only on 127.0.0.1. Override to 0.0.0.0
# only when you've put a TLS-terminating reverse proxy in front (or you're
# fine exposing plaintext over LAN).
BIND_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173

# ── Backups ───────────────────────────────────────────────────────────────────
# The api container runs apps/api/scripts/start.sh on every boot, which dumps
# the DB to the `pipelineflow-backups` volume before applying pending
# migrations. Plain restarts (no schema change) skip the dump. Files older
# than BACKUP_RETAIN_DAYS are pruned.
BACKUP_RETAIN_DAYS=30
# If a migration fails and Docker keeps restarting the api, the next pre-
# migrate dump is suppressed until this many seconds have passed since the
# last attempt — prevents a crash-loop from filling the backup volume.
BACKUP_DEBOUNCE_SEC=300

# ─── Google integrations (Contacts; later Gmail / Calendar) ──────────────────
# Required to enable the "Connect Google Account" flow in Settings →
# Integrations. Leave blank to ship without the integration; the routes
# return 503 until all four are set.
#
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application). Enable the People API for the same project.
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# AES-256-GCM key used to wrap the Google refresh token at rest. Must be
# exactly 32 bytes once base64-decoded. Generate with:
#   openssl rand -base64 32
# Rotating this key is a code-side migration: pre-rotate, decrypt with the
# old key, re-encrypt with the new one. Losing it means every connected
# user has to reconnect.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# How often the worker polls Google for incremental contact changes, in
# milliseconds. People API doesn't push, so a poll is the only way. The
# stored sync token expires after ~7 days of disuse, so don't dial this
# higher than ~6 days. Default: 600000 (10 minutes).
GOOGLE_CONTACTS_SYNC_INTERVAL_MS=600000
