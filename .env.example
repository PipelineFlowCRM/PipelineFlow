# Root-level shared environment for `docker compose up`.
# Copy to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=pipelineflow
# For local dev this is fine. For prod, generate a real one and change it.
POSTGRES_PASSWORD=pipelineflow
POSTGRES_DB=pipelineflow
# Bind to 5439 by default to avoid colliding with a native Postgres on 5432.
POSTGRES_PORT=5439

# ── API ───────────────────────────────────────────────────────────────────────
# Internal — Compose wires this for you. Override only if pointing at an external Postgres.
DATABASE_URL=postgresql://pipelineflow:pipelineflow@postgres:5432/pipelineflow

# Public origin of the web app (used for cookies, CORS, presigned-URL redirects).
APP_ORIGIN=http://localhost:5173

# ── S3 (attachments + avatars) ────────────────────────────────────────────────
S3_BUCKET=pipelineflow-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — set to a custom endpoint for MinIO/R2/etc. Leave blank for AWS.
S3_ENDPOINT=

# ── Networking ────────────────────────────────────────────────────────────────
# Default-deny: published ports listen only on 127.0.0.1. Override to 0.0.0.0
# only when you've put a TLS-terminating reverse proxy in front (or you're
# fine exposing plaintext over LAN).
BIND_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173

# ── Backups ───────────────────────────────────────────────────────────────────
# The api container runs apps/api/scripts/start.sh on every boot, which dumps
# the DB to the `pipelineflow-backups` volume before applying pending
# migrations. Plain restarts (no schema change) skip the dump. Files older
# than BACKUP_RETAIN_DAYS are pruned.
BACKUP_RETAIN_DAYS=30
# If a migration fails and Docker keeps restarting the api, the next pre-
# migrate dump is suppressed until this many seconds have passed since the
# last attempt — prevents a crash-loop from filling the backup volume.
BACKUP_DEBOUNCE_SEC=300
