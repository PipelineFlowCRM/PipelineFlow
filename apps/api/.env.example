PORT=4000
NODE_ENV=development
# Match POSTGRES_PORT in the root .env (default 5439 to avoid a native-Postgres collision).
DATABASE_URL=postgresql://pipelineflow:pipelineflow@localhost:5439/pipelineflow
# BullMQ broker. Outside docker, point at a local redis (or `docker compose up -d redis`).
# Match REDIS_PORT in the root .env (default 6380 to avoid a native-Redis collision).
# If you set REDIS_PASSWORD, embed it here too: redis://:yourpass@localhost:6380
REDIS_URL=redis://localhost:6380
# Set to false to skip mounting the bull-board UI at /admin/queues.
BULL_BOARD_ENABLED=true
# Smoke-test endpoint (POST /api/jobs/generate). Default true in dev so
# you can verify the queue locally; default false in compose-shipped prod.
JOBS_TEST_ENDPOINT_ENABLED=true
APP_ORIGIN=http://localhost:5173

S3_BUCKET=pipelineflow-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional: tighten or relax the auth-endpoint rate limiter.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_WINDOW_MS=300000

# ─── Anthropic / company enrichment ──────────────────────────────────────────
# See the root .env.example for full notes. ANTHROPIC_API_KEY blank ⇒ the
# /api/enrichment routes return 503 and the Settings → Enrichment card
# surfaces a "not configured on this server" banner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_ENRICHMENT_MAX_TOKENS=4096
