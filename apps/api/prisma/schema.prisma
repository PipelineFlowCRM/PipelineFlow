generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  avatarColor  String    @default("#6366f1")
  avatarUrl    String?
  theme        String    @default("system") // 'system' | 'light' | 'dark'
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  ownedDeals     Deal[]       @relation("DealOwner")
  tasks          Task[]       @relation("TaskAssignee")
  notes          Note[]       @relation("NoteAuthor")
  attachments    Attachment[] @relation("AttachmentUploader")
  activities     Activity[]   @relation("ActivityActor")
  listPrefs      UserListPreference[]
  apiTokens      ApiToken[]
  googleAccount  GoogleAccount?
  oauthStates    OAuthState[]
  importJobs     ImportJob[]
}

model Session {
  id          String   @id // opaque random token
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?

  @@index([userId])
  @@index([expiresAt])
}

model PipelineStage {
  id        Int      @id @default(autoincrement())
  name      String
  order     Int      @default(0)
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())

  deals     Deal[]

  @@index([order])
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String
  // Case-insensitive uniqueness on `name` is enforced via a raw SQL migration
  // (Prisma can't express functional indexes on lower(name) yet).
  industry     String?
  website      String?
  size         String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  notes        String?
  logoUrl      String?
  // External-system identity used by the CSV importer. `externalSource` is a
  // bucket key like "pipedrive" / "hubspot"; `externalId` is the source's row
  // id. Together they let re-imports of the same export update existing rows
  // instead of creating duplicates. The unique index excludes NULLs so rows
  // not created via import don't conflict with each other.
  externalId     String?
  externalSource String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@unique([externalSource, externalId], name: "company_external_uq")
  @@index([name])
}

model Contact {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  linkedin   String?
  notes      String?
  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // See Company.externalId — same idempotency mechanism for re-imports.
  externalId     String?
  externalSource String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  primaryDeals Deal[]              @relation("DealPrimaryContact")
  googleLinks  ContactGoogleLink[]

  @@unique([externalSource, externalId], name: "contact_external_uq")
  @@index([email])
  @@index([companyId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  // Case-insensitive uniqueness on `name` is enforced via a raw SQL
  // functional unique index `lower(name)` (same precedent as Company.name).
  name      String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments TagAttachment[]
}

// Polymorphic tag attachment. Mirrors the (entityType, entityId) shape used
// by CustomFieldValue — there is no DB-level FK on entityId, so each entity
// DELETE handler must clean up its rows explicitly (same as the existing
// customFieldValue.deleteMany cleanups).
model TagAttachment {
  id         Int               @id @default(autoincrement())
  tagId      Int
  tag        Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType CustomFieldEntity
  entityId   Int
  createdAt  DateTime          @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([tagId])
}

model Deal {
  id                 Int            @id @default(autoincrement())
  title              String
  amount             Decimal        @default(0) @db.Decimal(14, 2)
  currency           String         @default("USD")
  probability        Int            @default(0)
  expectedCloseDate  DateTime?      @db.Date
  stageId            Int
  stage              PipelineStage  @relation(fields: [stageId], references: [id])
  companyId          Int?
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContactId   Int?
  primaryContact     Contact?       @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  // ownerId is nullable so a user can delete their account without us having
  // to reassign every deal first. Single-tenant: any team member can still
  // see ownerless deals; the UI just renders them as "—".
  ownerId            Int?
  owner              User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageChangedAt     DateTime       @default(now())
  closedAt           DateTime?
  // See Company.externalId — same idempotency mechanism for re-imports.
  externalId         String?
  externalSource     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  boardOrder         Int            @default(0)

  notes       Note[]
  tasks       Task[]
  attachments Attachment[]
  activities  Activity[]

  @@unique([externalSource, externalId], name: "deal_external_uq")
  @@index([stageId, boardOrder])
  @@index([companyId])
  @@index([ownerId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime? @db.Date
  status      String    @default("pending") // 'pending' | 'completed'
  completedAt DateTime?
  dealId      Int?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedTo  Int?
  assignee    User?     @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments Attachment[]

  @@index([dueDate])
  @@index([status])
  @@index([dealId])
  @@index([assignedTo])
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  dealId    Int
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Author retained but nullable so user delete works. UI renders the author
  // chip as "—" when null. The note text itself remains.
  createdBy Int?
  author    User?    @relation("NoteAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([dealId])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  filename     String
  storedKey    String   // S3 object key
  contentType  String?
  sizeBytes    Int?
  dealId       Int?
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  taskId       Int?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   Int?
  uploader     User?    @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([dealId])
  @@index([taskId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  kind      String   // 'created' | 'stage_changed' | 'note_added' | 'task_added' | 'task_completed' | 'file_added' | 'file_deleted' | 'field_updated' | 'deal_won' | 'deal_lost'
  summary   String
  meta      String?  // optional JSON-as-string
  dealId    Int
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorId   Int?
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([createdAt])
  @@index([kind])
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

// ─── Custom fields ───────────────────────────────────────────────────────────
// User-defined fields attached to Contact/Company/Deal records. Stored EAV
// so that adding a field doesn't require a schema migration. Definitions can
// be inactivated (hides them from forms but keeps existing values readable);
// they can only be hard-deleted when no values exist (enforced both by the
// FK and by an explicit pre-check that returns a 409).

enum CustomFieldEntity {
  CONTACT
  COMPANY
  DEAL
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  MONEY
  DATE
  EMAIL
  URL
  PHONE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model CustomFieldDefinition {
  id           Int               @id @default(autoincrement())
  entityType   CustomFieldEntity
  // URL/JSON-safe key, unique per entityType. Stable identifier — used as the
  // map key in entity payloads so renaming `label` doesn't break clients.
  key          String
  label        String
  type         CustomFieldType
  isActive     Boolean           @default(true)
  isRequired   Boolean           @default(false)
  // Encoded as a JSON string so the same column can hold any type's default.
  defaultValue String?
  // For SELECT/MULTI_SELECT: array of { value, label, color? }.
  // For MONEY: { currency: 'USD' }. Nullable for the rest.
  options      Json?
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  values       CustomFieldValue[]

  @@unique([entityType, key])
  @@index([entityType, isActive, order])
}

model CustomFieldValue {
  id           Int                   @id @default(autoincrement())
  definitionId Int
  // Restrict on delete — we never want to lose values via a definition delete.
  // The /custom-fields DELETE handler pre-checks for this and inactivates
  // instead, returning 409 if you try to hard-delete one with values.
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  entityType   CustomFieldEntity
  entityId     Int
  // Typed columns. Exactly one is populated per row, chosen by the
  // definition's `type`. Multi-select values land in `valueJson` as a string array.
  valueText    String?
  valueNumber  Decimal?              @db.Decimal(20, 4)
  valueDate    DateTime?             @db.Date
  valueBool    Boolean?
  valueJson    Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([definitionId])
}

// ─── Outbound webhooks ──────────────────────────────────────────────────────
// User-configured HTTP endpoints that receive HMAC-signed event payloads when
// Deal/Company/Contact/Task records change. The `events` Json column stores a
// string[] of event-type names (e.g. ['deal.created']) — a flat array (not a
// relation) keeps event subscription updates atomic and avoids a join table
// for what's effectively a checkbox list.
//
// Delivery is fully async: emitWebhookEvent() inserts a `WebhookDelivery` row
// in 'pending' state and enqueues a BullMQ job that signs + POSTs and
// updates the row. Auto-disable kicks in once `consecutiveFailures` crosses a
// threshold (see lib/webhooks.ts).
model WebhookEndpoint {
  id                  Int      @id @default(autoincrement())
  name                String
  url                 String
  // Secret used for HMAC-SHA256 signatures. Generated server-side, returned
  // exactly once on create / rotate. Stored in plaintext — required to sign
  // outbound payloads, and the row itself is admin-restricted.
  secret              String
  enabled             Boolean  @default(true)
  // string[] — names from WEBHOOK_EVENTS. Validated against the catalog at
  // the route layer; the column itself is intentionally a free-form Json
  // array so adding a new event type is a code change, not a migration.
  events              Json
  // Optional Record<string,string> appended to outbound requests. Reserved
  // headers (X-PipelineFlow-*, Content-Type, User-Agent) are stripped server
  // side before merging.
  customHeaders       Json?
  // Reset to 0 on every successful delivery; incremented on each terminal
  // failure. Auto-disable triggers when this hits the threshold.
  consecutiveFailures Int      @default(0)
  // Set when the system auto-disables the endpoint, cleared when the user
  // re-enables it. Surfaced in the UI so they understand why it's off.
  disabledReason      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([enabled])
}

// One row per delivery attempt-set (i.e. per event fanned out to each
// endpoint). The BullMQ job retries this row in place — `attemptCount`
// tracks how many HTTP requests we've made, while `status` holds the
// final outcome. Successful and failed rows are retained indefinitely
// for now; a periodic cleanup job is intentionally deferred to a
// follow-up (TODO: trim 30d success / 90d failed once the table grows
// enough to matter).
model WebhookDelivery {
  id             Int      @id @default(autoincrement())
  endpointId     Int
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Stable event id (`evt_<nanoid>`) — same across retries; clients use it
  // to deduplicate.
  eventId        String
  eventType      String
  // Full payload sent (or to be sent). Snapshotted at emission time so a
  // later record edit doesn't change what historical deliveries contained.
  payload        Json
  // 'pending' | 'success' | 'failed'
  status         String   @default("pending")
  responseStatus Int?
  // Truncated to ~4KB at write time so a chatty endpoint can't blow up the
  // table.
  responseBody   String?
  errorMessage   String?
  attemptCount   Int      @default(0)
  jobId          String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?

  @@index([endpointId, createdAt])
  @@index([status])
  @@index([eventType])
}

// ─── API tokens (MCP / Public REST) ─────────────────────────────────────────
// Bearer tokens issued for non-interactive clients — primarily the MCP server
// at /api/mcp, but the same token type also gates the public REST surface
// once that ships. Tokens are tied to a User (the "owner" — actions taken
// with the token attribute back to that user in activity logs and webhook
// snapshots).
//
// Storage: we keep the token's high-entropy secret as an Argon2 hash, never
// in plaintext. The shipped token format is `pf_<id>_<secret>` — splitting
// the public id out lets us look the row up by indexed PK without scanning
// every hash. The id segment is base64url-encoded random bytes (10 bytes,
// ~80 bits — plenty for an opaque public id) and the secret is 32 random
// bytes (~256 bits, well beyond brute-force).
//
// `scopes` is a JSON string array of granted scopes (`read`, `write`,
// `delete`). The MCP layer enforces these per-tool: tools without an
// allowed scope simply aren't exposed to that token's session, so an
// agent can't even see a destructive tool when its token lacks `delete`.
model ApiToken {
  id          String    @id // public token id segment (`tok_<random>`)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Argon2id hash of the secret half of the token. Verified with the same
  // argon2 module used for password hashes — constant-time, memory-hard.
  secretHash  String
  // string[] of granted scopes. Validated against the catalog at the route
  // layer; the column itself is a free-form JSON array so adding a new
  // scope is a code change rather than a migration.
  scopes      Json
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  // Set when the user revokes the token via the settings UI; the row is
  // kept so the audit log can still reference it. Lookups treat
  // `revokedAt != null` as "expired".
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditEvents     McpAuditEvent[]
  approvalTokens  McpApprovalToken[]

  @@index([userId])
  @@index([revokedAt])
}

// Append-only log of every MCP call. We log both reads and writes — reads
// at info level, writes at notice — so an operator can answer "what did
// the agent do" weeks after the fact. Truncated arg/result blobs prevent
// a chatty agent from blowing up the table.
model McpAuditEvent {
  id           Int      @id @default(autoincrement())
  tokenId      String?
  token        ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  // Snapshot of the user the token was issued to at call time. Set null if
  // the user is later deleted — the audit row stays.
  actorUserId  Int?
  toolName     String
  // 'success' | 'error' | 'approval_required' | 'approval_consumed'
  outcome      String
  // Truncated JSON of the input args (PII-bearing fields are passed
  // through; if you don't want them logged, don't pass them through MCP).
  args         Json?
  // Optional human-readable summary ("deleted Deal #42 — Acme Corp").
  summary      String?
  // Populated on `outcome = error` with the error message.
  errorMessage String?
  // Set when the call required (or consumed) an approval token; lets us
  // join an approve-and-act pair in the log without a follow-up query.
  approvalId   String?
  createdAt    DateTime @default(now())

  @@index([tokenId, createdAt])
  @@index([toolName, createdAt])
  @@index([createdAt])
}

// Two-phase confirmation for destructive tools. The first call to e.g.
// `pipeline.delete_deal` without `confirmationToken` returns one of these
// rows' id; the second call must echo it. The token is bound to the
// (toolName, argsFingerprint, tokenId) tuple so an agent can't reuse a
// confirmation issued for one delete to perform a different one.
//
// Tokens are single-use (consumedAt nulls → set on first successful use)
// and time-limited (default 5 minutes). Expired/consumed tokens fail
// closed.
model McpApprovalToken {
  id              String    @id // `appr_<random>`
  tokenId         String
  apiToken        ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  toolName        String
  // sha256 hex of the canonical-JSON args. The mutate path recomputes
  // this from the new call's args and rejects if it doesn't match the
  // stored fingerprint — agents can't approve "delete deal 1" and then
  // use the token to delete deal 2.
  argsFingerprint String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([tokenId])
  @@index([expiresAt])
}

// ─── Google integrations ────────────────────────────────────────────────────
// Per-user connection to a Google account. Scoping is per-user (option C from
// the design plan): each PF user connects their own Google; inbound (Google →
// PF) is automatic once connected, outbound (PF → Google) is opt-in via
// GoogleContactsSync.outboundEnabled. The user-level model keeps the OAuth
// flow simple — the request that finishes the consent dance always knows
// which user to attach the row to — and gives each user a stable place to
// hang Gmail / Calendar children when those land.
//
// `encryptedRefreshToken` wraps the long-lived refresh token with AES-256-GCM
// (see lib/crypto.ts). The short-lived access token can either be re-minted
// on demand from the refresh token or cached in `accessToken` until
// `accessTokenExpiresAt` — we cache it because the worker can fan out many
// People API calls in a single sync run and a token-mint per call is wasted
// work.
model GoogleAccount {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `sub` from Google's id_token — stable across email changes, the
  // canonical cross-app identifier for a Google account.
  googleSub             String    @unique
  googleEmail           String
  encryptedRefreshToken String
  // string[] of granted OAuth scopes — e.g. ["https://www.googleapis.com/auth/contacts"].
  // Stored as Json so adding a new integration scope is a code change, not a
  // migration. Compared against the consent screen's required scopes when
  // routing jobs.
  scopes                Json
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  connectedAt           DateTime  @default(now())
  lastRefreshedAt       DateTime?
  // Set when `invalid_grant` comes back from Google (user revoked access,
  // password reset, refresh token expired after long disuse). Surfaced in
  // the settings UI so the user can reconnect; non-null disables both the
  // pull cron and any push enqueues.
  disabledAt            DateTime?
  disabledReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contactsSync GoogleContactsSync?
  contactLinks ContactGoogleLink[]
}

// One row per (account × integration). For now there's only the contacts
// child; Gmail and Calendar will land as siblings when those integrations
// ship. Splitting per-integration state out of GoogleAccount means a future
// "disable contacts but keep Gmail" toggle is trivial.
model GoogleContactsSync {
  googleAccountId      Int           @id
  account              GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  // Delta sync pointer issued by People API; null until the first incremental
  // run, at which point we pin the syncToken returned by `connections.list`.
  // Google expires unused tokens after ~7 days; on 410 Gone we fall back to
  // a full sync.
  syncToken            String?
  // Resume token for an in-flight initial import. Cleared once the import
  // completes and the syncToken is stored.
  initialPageToken     String?
  initialImportedCount Int           @default(0)
  fullSyncDoneAt       DateTime?
  lastPulledAt         DateTime?
  lastPushedAt         DateTime?
  // Inbound is on the moment the user connects — the whole point of
  // connecting is to read Google's address book into PF. Outbound is the
  // surprising direction (other users could see your edits flow through
  // to your personal Google contacts) so it's opt-in.
  inboundEnabled       Boolean       @default(true)
  outboundEnabled      Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// Many-to-one mapping from PF Contact to Google Person. Multiple users in
// the workspace can connect their own Google accounts and the same PF
// Contact can therefore have several link rows — one per connected user
// whose address book contains that person. Cross-user matching during
// inbound (email-first) prevents this from creating duplicate Contacts.
//
// `lastPushedHash` / `lastPulledHash` are the echo-loop guard: each side
// stores the sha256 of the canonical Person body it last sent (push) or
// received (pull); before writing in either direction we compare the
// would-be body hash against the opposite side's stored hash and skip if
// they match. Strictly better than a "currently syncing" flag — stateless,
// crash-safe, survives across processes.
model ContactGoogleLink {
  id              Int           @id @default(autoincrement())
  contactId       Int
  googleAccountId Int
  resourceName    String
  // Optimistic concurrency token from People API. Cached on every
  // successful pull; refreshed via re-fetch on a 412 from a push.
  etag            String
  lastSyncedAt    DateTime      @default(now())
  lastPushedHash  String?
  lastPulledHash  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)

  @@unique([googleAccountId, resourceName])
  @@index([contactId])
  @@index([googleAccountId, lastSyncedAt])
}

// Short-lived nonce table for the OAuth `state` parameter. Rather than
// stuffing state into the existing Session row (which has SameSite quirks
// during the cross-site redirect chain in some browsers), we mint a fresh
// row at /start, hand its id to Google, and consume it at /callback. The
// row is bound to the user that initiated the flow so a callback that
// arrives in a different session is rejected.
model OAuthState {
  id         String    @id
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  intent     String
  // Json string[] — the scopes the consent screen was asked to grant.
  // Re-validated on callback against what Google actually returned so a
  // user that downgrades scopes mid-consent doesn't get a permission
  // mismatch with the stored row.
  scopes     Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// Per-user UI preferences for list views (column visibility, filters).
// Single-tenant app, but each signed-in user still gets their own layout.
model UserListPreference {
  id         Int               @id @default(autoincrement())
  userId     Int
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType CustomFieldEntity
  // JSON blob: { columns: string[]; filters: ListFilter[] } — see ListPrefs in
  // packages/shared. `columns` are visible-column keys (built-in or `cf:<key>`);
  // `filters` are { key, op, value } triples evaluated against each list view.
  prefs      Json
  updatedAt  DateTime          @updatedAt

  @@unique([userId, entityType])
  @@index([userId])
}

// ─── CSV import jobs ────────────────────────────────────────────────────────
// One row per upload (dry-run or commit). Holds enough state for the wizard
// to resume between steps without re-uploading, and serves as the audit
// trail surfaced at /settings/import. The original file lives in S3 under
// `imports/{id}.csv`; `errors` is capped at 1 000 rows in JSON for fast
// dashboard rendering, with the full error CSV available on demand from
// the same S3 source via the row download endpoint.
model ImportJob {
  id           String    @id @default(cuid())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType   String    // 'company' | 'contact' | 'deal'
  sourceFile   String    // S3 key, `imports/<id>.csv`
  filename     String    // original upload filename for display
  // pending → validating → validated → committing → completed | failed
  status       String    @default("pending")
  // { csvHeader: canonicalField | null } — null means "ignore this column".
  mapping      Json?
  // For Deal imports: { sourceStageName: pipelineStageId }.
  stageMapping Json?
  presetUsed   String?   // preset key (e.g. "pipedrive-persons") if detected
  totalRows    Int       @default(0)
  createdRows  Int       @default(0)
  updatedRows  Int       @default(0)
  errorRows    Int       @default(0)
  // Auto-create counters for relationship resolution: stub Companies created
  // when a Contact references a missing company name, stub Contacts created
  // when a Deal references a missing primaryContact email.
  stubCompaniesCreated Int @default(0)
  stubContactsCreated  Int @default(0)
  // Truncated to the first 1 000 errors. The full set can be regenerated
  // from the source CSV by replaying the import without committing.
  errors       Json?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
