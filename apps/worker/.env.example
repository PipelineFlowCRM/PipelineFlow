NODE_ENV=development
# Match POSTGRES_PORT in the root .env (default 5439 to avoid a native-Postgres collision).
DATABASE_URL=postgresql://pipelineflow:pipelineflow@localhost:5439/pipelineflow
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001

# ─── Google integrations ─────────────────────────────────────────────────────
# Same client credentials and encryption key as the api — the worker
# decrypts the stored refresh token and uses the OAuth client to mint
# fresh access tokens for each sync. Must match the api's values exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── Anthropic / company enrichment ──────────────────────────────────────────
# Same key + model as the api — both processes run independent Anthropic
# clients (the api owns the /ping smoke test; the worker owns the actual
# enrichment runs). ANTHROPIC_ALLOW_PRIVATE_TARGETS gates the website-
# fetch SSRF guard (defaults true to mirror WEBHOOKS_ALLOW_PRIVATE_TARGETS;
# flip to false on public-facing deploys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_ENRICHMENT_MAX_TOKENS=4096
ENRICHMENT_ALLOW_PRIVATE_TARGETS=true
