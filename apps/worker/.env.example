NODE_ENV=development
# Match POSTGRES_PORT in the root .env (default 5439 to avoid a native-Postgres collision).
DATABASE_URL=postgresql://pipelineflow:pipelineflow@localhost:5439/pipelineflow
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001

# ─── Google integrations ─────────────────────────────────────────────────────
# Same client credentials and encryption key as the api — the worker
# decrypts the stored refresh token and uses the OAuth client to mint
# fresh access tokens for each sync. Must match the api's values exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
